# ============================================
# Environment Variables — Origin
# Copy to .env and adjust values as needed
# ============================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=genealogie_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genealogie_dev?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth / JWT
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=90d
OTP_EXPIRY_MINUTES=5
PIN_SALT_ROUNDS=10

# AWS / LocalStack
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
AWS_KMS_KEY_ID=

# S3 Buckets
S3_BUCKET_PHOTOS=genealogie-photos-public
S3_BUCKET_DOCUMENTS=genealogie-documents-private

# Mail (MailHog in dev)
SMTP_HOST=localhost
SMTP_PORT=1025

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=debug

# Twilio SMS / WhatsApp — get values from https://console.twilio.com
# Leave empty to fall back to MockOtpSender (logs OTP to console; dev only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional: WhatsApp-enabled sender like whatsapp:+14155238886 (Twilio sandbox or approved)
TWILIO_WHATSAPP_FROM=
# When true and NODE_ENV=development, full OTP code is logged after sending (dev convenience).
# Default false — never enable in production.
OTP_LOG_IN_DEV=false

# Comma-separated list of allowed origins for CORS. NEVER "*" in production
# (Joi will reject it when NODE_ENV=production).
CORS_ORIGIN=http://localhost:3001

# Off by default; only enable in dev so the schema is not exposed publicly.
SWAGGER_ENABLED=false

# trust proxy: 0 (no proxy), 1 (one trusted hop), or a comma-separated CIDR.
TRUST_PROXY=0

# Public base URL of the web app — used in invitation links sent via SMS/WhatsApp
WEB_APP_URL=http://localhost:3001
