// ============================================
// ADMIN AUDIT LOG
// Append-only journal of every privileged action performed via the
// admin dashboard. Distinct from `contributions` (which tracks user
// edits to graph data) so admin oversight cannot be obscured by
// rewriting domain history.
// ============================================
model AdminAuditLog {
  id                  String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  actorAccountId      String              @map("actor_account_id") @db.Uuid
  actorRole           AccountRole         @map("actor_role")
  action              String              @db.VarChar(100)
  category            String              @db.VarChar(50)
  severity            AdminActionSeverity @default(INFO)
  targetEntityType    String?             @map("target_entity_type") @db.VarChar(50)
  targetEntityId      String?             @map("target_entity_id") @db.Uuid
  targetAccountId     String?             @map("target_account_id") @db.Uuid
  reason              String?
  beforeState         Json?               @map("before_state")
  afterState          Json?               @map("after_state")
  metadata            Json?
  ipAddress           String?             @map("ip_address") @db.Inet
  userAgent           String?             @map("user_agent") @db.VarChar(500)
  requestId           String?             @map("request_id") @db.VarChar(64)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  actorAccount  Account  @relation("AdminAuditActor", fields: [actorAccountId], references: [id])
  targetAccount Account? @relation("AdminAuditTargetAccount", fields: [targetAccountId], references: [id])

  @@index([actorAccountId, createdAt(sort: Desc)], map: "idx_admin_audit_actor")
  @@index([targetEntityType, targetEntityId], map: "idx_admin_audit_target_entity")
  @@index([targetAccountId, createdAt(sort: Desc)], map: "idx_admin_audit_target_account")
  @@index([category, createdAt(sort: Desc)], map: "idx_admin_audit_category")
  @@index([createdAt(sort: Desc)], map: "idx_admin_audit_created")
  @@map("admin_audit_logs")
}

// ============================================
// PHASE 1 — LIFE EVENTS & SOCIAL FEED
// Additive models for life-event timeline + family/public feed.
// Cross-aggregate references (Account/Person/Union) are kept as plain
// scalar UUID columns here; the real FOREIGN KEY constraints are declared
// in the hand-written migration. This keeps the additive change free of
// edits to the existing Account/Person/Union models (no back-relation
// fields required on them). Relations strictly between the new models are
// expressed as full Prisma relations.
// ============================================

enum LifeEventKind {
  BIRTH
  DEATH
  UNION

  @@map("life_event_kind")
}

// A dated, visibility-scoped fact about one or more persons in the graph
// (birth, death, union). The subject is primary_person_id; additional
// involved persons are joined via LifeEventParticipant. occurred_at reuses
// the existing DatePrecision enum to model fuzzy historical dates.
model LifeEvent {
  id                  String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  kind                LifeEventKind
  primaryPersonId     String          @map("primary_person_id") @db.Uuid
  unionId             String?         @map("union_id") @db.Uuid
  occurredAt          DateTime?       @map("occurred_at") @db.Timestamptz()
  occurredAtPrecision DatePrecision   @default(UNKNOWN) @map("occurred_at_precision")
  createdByAccountId  String          @map("created_by_account_id") @db.Uuid
  visibilityScope     VisibilityScope @default(FAMILY) @map("visibility_scope")
  visibleMaxDegree    Int?            @map("visible_max_degree")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt           DateTime?       @map("deleted_at") @db.Timestamptz()

  participants LifeEventParticipant[]
  feedPosts    FeedPost[]

  @@index([primaryPersonId], map: "idx_life_events_primary_person")
  @@index([unionId], map: "idx_life_events_union")
  @@index([createdByAccountId], map: "idx_life_events_created_by")
  @@index([kind], map: "idx_life_events_kind")
  @@index([createdAt(sort: Desc)], map: "idx_life_events_created")
  @@map("life_events")
}

// Additional persons involved in a life event beyond the primary subject
// (e.g. both partners of a UNION, a parent recorded on a BIRTH). role is a
// free-form string ('subject' | 'partner' | 'parent' | ...).
model LifeEventParticipant {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lifeEventId String   @map("life_event_id") @db.Uuid
  personId    String   @map("person_id") @db.Uuid
  role        String   @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  lifeEvent LifeEvent @relation(fields: [lifeEventId], references: [id], onDelete: Cascade)

  @@unique([lifeEventId, personId, role], map: "uq_life_event_participant")
  @@index([lifeEventId], map: "idx_life_event_participants_event")
  @@index([personId], map: "idx_life_event_participants_person")
  @@map("life_event_participants")
}

// A social-feed post, optionally derived from a LifeEvent. For FAMILY
// visibility the OWNER personId used by VisibilityGuard/GraphDegreeService
// is subject_person_id (the person the post is about).
model FeedPost {
  id               String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lifeEventId      String?         @map("life_event_id") @db.Uuid
  authorAccountId  String          @map("author_account_id") @db.Uuid
  subjectPersonId  String?         @map("subject_person_id") @db.Uuid
  postType         String          @map("post_type") @db.VarChar(50)
  body             String?
  visibilityScope  VisibilityScope @default(FAMILY) @map("visibility_scope")
  visibleMaxDegree Int?            @map("visible_max_degree")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz()

  lifeEvent LifeEvent?     @relation(fields: [lifeEventId], references: [id], onDelete: SetNull)
  reactions FeedReaction[]
  comments  FeedComment[]

  @@index([subjectPersonId], map: "idx_feed_posts_subject_person")
  @@index([authorAccountId], map: "idx_feed_posts_author")
  @@index([lifeEventId], map: "idx_feed_posts_life_event")
  @@index([visibilityScope, createdAt(sort: Desc)], map: "idx_feed_posts_visibility_created")
  @@index([createdAt(sort: Desc)], map: "idx_feed_posts_created")
  @@map("feed_posts")
}

model FeedReaction {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  feedPostId   String    @map("feed_post_id") @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  reactionType String    @map("reaction_type") @db.VarChar(30)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz()

  feedPost FeedPost @relation(fields: [feedPostId], references: [id], onDelete: Cascade)

  @@unique([feedPostId, accountId, reactionType], map: "uq_feed_reaction")
  @@index([feedPostId], map: "idx_feed_reactions_post")
  @@index([accountId], map: "idx_feed_reactions_account")
  @@map("feed_reactions")
}

model FeedComment {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  feedPostId String    @map("feed_post_id") @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  body       String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz()

  feedPost FeedPost @relation(fields: [feedPostId], references: [id], onDelete: Cascade)

  @@index([feedPostId], map: "idx_feed_comments_post")
  @@index([accountId], map: "idx_feed_comments_account")
  @@map("feed_comments")
}

// ============================================
// PHASE 2 — PUBLIC CULTURAL HERITAGE & MODERATION
// Additive models for the PUBLIC discovery world (cultural heritage content
// authored by the community and by verified authorities/chefferies) plus a
// generic moderation report queue.
//
// These models live in the PUBLIC world and must NEVER reference or leak
// family-graph edges, relationships, degrees, phone numbers or other private
// person data. Cross-aggregate references to accounts/media are kept as plain
// scalar UUID columns here; the real FOREIGN KEY constraints are declared in
// the hand-written migration, keeping the change additive on the existing
// Account/Media models (no back-relation fields required on them). Relations
// strictly between the new Phase-2 models are expressed as full Prisma
// relations.
// ============================================

enum CulturalAuthorityKind {
  CHEFFERIE
  EXPERT
  INSTITUTION

  @@map("cultural_authority_kind")
}

enum CulturalContentType {
  LANGUAGE
  RECIPE
  TALE
  PROVERB
  RITE
  CUSTOM
  MUSIC
  OTHER
  PEOPLE

  @@map("cultural_content_type")
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("moderation_status")
}

enum ModerationTargetType {
  CULTURAL_CONTENT
  FEED_POST
  FEED_COMMENT
  PERSON

  @@map("moderation_target_type")
}

enum ModerationReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED

  @@map("moderation_report_status")
}

// A verified (or pending-verification) cultural authority: a chefferie, a
// subject-matter expert, or an institution. One authority per account
// (account_id unique). Verification is performed by a moderator/admin
// (verified_by_account_id) and never exposes the account's private data.
model CulturalAuthority {
  id                   String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  accountId            String                @unique @map("account_id") @db.Uuid
  kind                 CulturalAuthorityKind
  displayName          String                @map("display_name") @db.VarChar(255)
  region               String?               @db.VarChar(100)
  ethnicGroup          String?               @map("ethnic_group") @db.VarChar(100)
  bio                  String?
  verified             Boolean               @default(false)
  verifiedAt           DateTime?             @map("verified_at") @db.Timestamptz()
  verifiedByAccountId  String?               @map("verified_by_account_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamptz()

  contents CulturalContent[]

  @@index([kind], map: "idx_cultural_authorities_kind")
  @@index([verified], map: "idx_cultural_authorities_verified")
  @@index([ethnicGroup], map: "idx_cultural_authorities_ethnic_group")
  @@index([region], map: "idx_cultural_authorities_region")
  @@map("cultural_authorities")
}

// A piece of PUBLIC cultural-heritage content (language, recipe, tale,
// proverb, rite, custom, music, ...). Authored by an account and optionally
// attributed to a CulturalAuthority. Goes through moderation
// (moderation_status) before appearing in the public discovery feed.
// visibility_scope defaults to PUBLIC; this content carries NO family-graph
// data. is_from_verified_authority is a denormalized flag used to prioritize
// verified-authority content in the discovery feed.
model CulturalContent {
  id                       String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  authorAccountId          String              @map("author_account_id") @db.Uuid
  authorityId              String?             @map("authority_id") @db.Uuid
  contentType              CulturalContentType @map("content_type")
  title                    String              @db.VarChar(255)
  body                     String?
  languageCode             String?             @map("language_code") @db.VarChar(10)
  region                   String?             @db.VarChar(100)
  ethnicGroup              String?             @map("ethnic_group") @db.VarChar(100)
  mediaId                  String?             @map("media_id") @db.Uuid
  imageUrl                 String?             @map("image_url") @db.VarChar(500)
  visibilityScope          VisibilityScope     @default(PUBLIC) @map("visibility_scope")
  moderationStatus         ModerationStatus    @default(PENDING) @map("moderation_status")
  isFromVerifiedAuthority  Boolean             @default(false) @map("is_from_verified_authority")
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt                DateTime?           @map("deleted_at") @db.Timestamptz()

  authority CulturalAuthority? @relation(fields: [authorityId], references: [id])

  @@index([moderationStatus, createdAt(sort: Desc)], map: "idx_cultural_content_moderation_created")
  @@index([contentType], map: "idx_cultural_content_type")
  @@index([ethnicGroup], map: "idx_cultural_content_ethnic_group")
  @@index([authorityId], map: "idx_cultural_content_authority")
  @@map("cultural_content")
}

// A generic moderation report raised by an account against any moderatable
// target (cultural content, feed post, feed comment, person). Drives the
// real-time moderation queue. target_id is a plain UUID (polymorphic by
// target_type) so no FK is declared for it.
model ModerationReport {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reporterAccountId    String                 @map("reporter_account_id") @db.Uuid
  targetType           ModerationTargetType   @map("target_type")
  targetId             String                 @map("target_id") @db.Uuid
  reason               String                 @db.VarChar(50)
  details              String?
  status               ModerationReportStatus @default(OPEN)
  resolvedByAccountId  String?                @map("resolved_by_account_id") @db.Uuid
  resolution           String?
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  resolvedAt           DateTime?              @map("resolved_at") @db.Timestamptz()

  @@index([status, createdAt], map: "idx_moderation_reports_status_created")
  @@index([targetType, targetId], map: "idx_moderation_reports_target")
  @@map("moderation_reports")
}

// ============================================
// PHASE 3 — "SOMMES-NOUS PARENTS ?" (KINSHIP CHECK)
// The signature consent-gated relatedness probe. Two accounts mutually
// consent; the system computes whether they are related THROUGH the global
// graph (via GraphDegreeService) and persists ONLY the aggregate result:
// a boolean, a bounded degree, and a derived human label (FR/EN).
//
// PRIVACY INVARIANT (non-negotiable): NO person ids, names, ancestors, or
// graph path are EVER stored here. The graph is read transiently at compute
// time and everything except the degree + label is discarded. Cross-aggregate
// references to accounts are kept as plain scalar UUID columns (the real
// FOREIGN KEY constraints are declared in the hand-written migration), keeping
// this change additive on the existing Account model (no back-relation fields
// required on it). Computation happens ONLY after BOTH parties consent.
// ============================================

enum KinshipCheckStatus {
  PENDING_CONSENT
  CONSENTED
  DECLINED
  COMPUTED
  EXPIRED
  CANCELLED

  @@map("kinship_check_status")
}

model KinshipCheck {
  id                  String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  requesterAccountId  String             @map("requester_account_id") @db.Uuid
  targetAccountId     String?            @map("target_account_id") @db.Uuid
  targetPhone         String?            @map("target_phone") @db.VarChar(20)
  status              KinshipCheckStatus @default(PENDING_CONSENT)
  requesterConsent    Boolean            @default(true) @map("requester_consent")
  targetConsent       Boolean            @default(false) @map("target_consent")
  resultDegree        Int?               @map("result_degree")
  resultRelated       Boolean?           @map("result_related")
  resultLabelFr       String?            @map("result_label_fr") @db.VarChar(120)
  resultLabelEn       String?            @map("result_label_en") @db.VarChar(120)
  computedAt          DateTime?          @map("computed_at") @db.Timestamptz()
  expiresAt           DateTime?          @map("expires_at") @db.Timestamptz()
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt           DateTime?          @map("deleted_at") @db.Timestamptz()

  @@index([requesterAccountId], map: "idx_kinship_checks_requester")
  @@index([targetAccountId], map: "idx_kinship_checks_target")
  @@index([status], map: "idx_kinship_checks_status")
  @@index([targetPhone], map: "idx_kinship_checks_target_phone")
  @@map("kinship_checks")
}

// ============================================
// PHASE 4 — LIVING MEMORY (the emotional moat)
// Additive models for: ALBUMS (a person's life curated over time), and
// MEMORIAL TRIBUTES (candles / messages / photos / videos honoring the
// DECEASED). Oral history REUSES the existing Source model as-is
// (media_file_id + audio_transcript + visibility_scope) — no new column is
// added there.
//
// Cross-aggregate references (Account / Person / Media) are kept as plain
// scalar UUID columns here; the real FOREIGN KEY constraints are declared in
// the hand-written migration, keeping the change additive on the existing
// Account / Person / Media models (no back-relation fields required on them).
// The relation strictly between the two new Album models (Album <-> AlbumItem)
// is expressed as a full Prisma relation.
//
// Visibility: Albums default PRIVATE_SELF (opt-in family/public); Memorial
// tributes default FAMILY. Both respect the VisibilityScope / GraphDegree
// model, write a Contribution audit row on mutation (enforced in services),
// and are soft-deleted (deleted_at). Memorial tributes are only permitted on
// a Person whose life_status = DECEASED (enforced in the service layer).
// ============================================

enum AlbumKind {
  PERSONAL
  FAMILY
  EVENT

  @@map("album_kind")
}

enum MemorialTributeKind {
  CANDLE
  MESSAGE
  PHOTO
  VIDEO

  @@map("memorial_tribute_kind")
}

// An album documenting a person's life over time (e.g. a parent curating a
// child from newborn to adult). subject_person_id is the person the album is
// ABOUT (nullable — an EVENT/FAMILY album may have no single subject) and is
// the OWNER personId used by VisibilityGuard/GraphDegreeService for FAMILY
// scope. owner_account_id is the curator. cover_media_id is an optional
// Media reference for the album cover.
model Album {
  id               String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  subjectPersonId  String?         @map("subject_person_id") @db.Uuid
  ownerAccountId   String          @map("owner_account_id") @db.Uuid
  title            String          @db.VarChar(200)
  description      String?
  kind             AlbumKind       @default(PERSONAL)
  coverMediaId     String?         @map("cover_media_id") @db.Uuid
  visibilityScope  VisibilityScope @default(PRIVATE_SELF) @map("visibility_scope")
  visibleMaxDegree Int?            @map("visible_max_degree")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz()

  items AlbumItem[]

  @@index([subjectPersonId], map: "idx_albums_subject_person")
  @@index([ownerAccountId], map: "idx_albums_owner_account")
  @@index([visibilityScope], map: "idx_albums_visibility")
  @@map("albums")
}

// A single entry in an album, referencing one Media item with an optional
// caption, capture date (taken_at, plus taken_at_text for fuzzy/historical
// dates) and an explicit ordering position within the album.
model AlbumItem {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  albumId     String    @map("album_id") @db.Uuid
  mediaId     String    @map("media_id") @db.Uuid
  caption     String?   @db.VarChar(500)
  takenAt     DateTime? @map("taken_at") @db.Date
  takenAtText String?   @map("taken_at_text") @db.VarChar(100)
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, position], map: "idx_album_items_album_position")
  @@map("album_items")
}

// A tribute left on a DECEASED person to honor an ancestor: a lit candle, a
// written memory, or a photo/video. person_id is the OWNER personId used by
// VisibilityGuard/GraphDegreeService. The service MUST verify
// Person.life_status = DECEASED before creating a tribute (blocked on ALIVE).
model MemorialTribute {
  id               String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  personId         String              @map("person_id") @db.Uuid
  authorAccountId  String              @map("author_account_id") @db.Uuid
  kind             MemorialTributeKind
  message          String?
  mediaId          String?             @map("media_id") @db.Uuid
  visibilityScope  VisibilityScope     @default(FAMILY) @map("visibility_scope")
  visibleMaxDegree Int?                @map("visible_max_degree")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz()

  @@index([personId, createdAt(sort: Desc)], map: "idx_memorial_tributes_person_created")
  @@index([authorAccountId], map: "idx_memorial_tributes_author")
  @@map("memorial_tributes")
}

// ============================================
// PHASE 5 — LIVE (the engagement accelerator)
// Additive models for real-time audio-first LIVE sessions built on LiveKit
// Cloud (managed SFU). Two worlds:
//   - PRIVATE/FAMILY lives (funerals, ceremonies, family councils) — bounded
//     by visible_max_degree around subject_person_id (GraphDegreeService).
//   - PUBLIC lives (language lessons, cooking, storytelling, masterclasses)
//     hosted by VERIFIED authorities/experts, open to any authenticated user.
// Sessions are systematically RECORDED; the recording (recording_media_id)
// becomes a REPLAY that, once published, feeds the public/family feed
// (solving cold-start). LiveKit access is via short-lived tokens minted
// server-side and is fully gated on env creds (graceful "not configured").
//
// Cross-aggregate references (Account / CulturalAuthority / Person / Media)
// are kept as plain scalar UUID columns here; the real FOREIGN KEY constraints
// are declared in the hand-written migration, keeping the change additive on
// the existing Account / CulturalAuthority / Person / Media models (no
// back-relation fields required on them). The relation strictly between the
// two new models (LiveSession <-> LiveParticipant) is a full Prisma relation.
// Soft-delete on LiveSession; mutations write a Contribution audit row
// (enforced in services).
// ============================================

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED

  @@map("live_session_status")
}

enum LiveSessionKind {
  CEREMONY
  FAMILY_COUNCIL
  LESSON
  STORYTELLING
  MASTERCLASS
  OTHER

  @@map("live_session_kind")
}

enum LiveInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED

  @@map("live_invitation_status")
}

// A real-time LIVE session. host_account_id is the broadcaster; for PUBLIC
// LESSON/MASTERCLASS the host may act as a verified CulturalAuthority
// (host_authority_id). For PRIVATE/FAMILY ceremonies, subject_person_id is the
// person the live concerns AND the OWNER personId used by
// VisibilityGuard/GraphDegreeService for FAMILY-scope, degree-bounded access.
// room_name is the unique LiveKit room. recording_media_id is the replay
// recording; replay_published gates whether it has been surfaced to the feed.
model LiveSession {
  id                 String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  hostAccountId      String            @map("host_account_id") @db.Uuid
  hostAuthorityId    String?           @map("host_authority_id") @db.Uuid
  title              String            @db.VarChar(200)
  description        String?
  kind               LiveSessionKind
  visibilityScope    VisibilityScope   @default(FAMILY) @map("visibility_scope")
  visibleMaxDegree   Int?              @map("visible_max_degree")
  subjectPersonId    String?           @map("subject_person_id") @db.Uuid
  roomName           String            @unique @map("room_name") @db.VarChar(120)
  inviteCode         String?           @unique @map("invite_code") @db.VarChar(16)
  status             LiveSessionStatus @default(SCHEDULED)
  scheduledAt        DateTime?         @map("scheduled_at") @db.Timestamptz()
  startedAt          DateTime?         @map("started_at") @db.Timestamptz()
  endedAt            DateTime?         @map("ended_at") @db.Timestamptz()
  recordingMediaId   String?           @map("recording_media_id") @db.Uuid
  replayPublished    Boolean           @default(false) @map("replay_published")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz()

  participants LiveParticipant[]
  invitations  LiveInvitation[]

  @@index([status, scheduledAt], map: "idx_live_sessions_status_scheduled")
  @@index([hostAccountId], map: "idx_live_sessions_host_account")
  @@index([visibilityScope], map: "idx_live_sessions_visibility")
  @@index([subjectPersonId], map: "idx_live_sessions_subject_person")
  @@map("live_sessions")
}

// A participant in a LIVE session. role is a free-form short string
// ('host' | 'speaker' | 'viewer'). joined_at/left_at track presence; a row is
// unique per (session, account).
model LiveParticipant {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  liveSessionId String    @map("live_session_id") @db.Uuid
  accountId     String    @map("account_id") @db.Uuid
  role          String    @db.VarChar(20)
  handRaised    Boolean   @default(false) @map("hand_raised")
  isSpeaker     Boolean   @default(false) @map("is_speaker")
  joinedAt      DateTime? @map("joined_at") @db.Timestamptz()
  leftAt        DateTime? @map("left_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@unique([liveSessionId, accountId], map: "uq_live_participant_session_account")
  @@index([liveSessionId], map: "idx_live_participants_session")
  @@map("live_participants")
}

// An invitation to a LIVE session. The inviter (inviter_account_id, a host or
// co-host) invites either an existing account (invited_account_id) or a phone
// number not yet on the platform (invited_phone, E.164). status tracks the
// invitee's response. Cross-aggregate references to accounts are plain scalar
// UUID columns (no back-relation fields on Account); the real FOREIGN KEY
// constraints are declared in the hand-written migration. The relation to
// LiveSession is a full Prisma relation (FK + cascade). Soft-deletable.
model LiveInvitation {
  id                String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  liveSessionId     String               @map("live_session_id") @db.Uuid
  inviterAccountId  String               @map("inviter_account_id") @db.Uuid
  invitedAccountId  String?              @map("invited_account_id") @db.Uuid
  invitedPhone      String?              @map("invited_phone") @db.VarChar(20)
  status            LiveInvitationStatus @default(PENDING)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  respondedAt       DateTime?            @map("responded_at") @db.Timestamptz()
  deletedAt         DateTime?            @map("deleted_at") @db.Timestamptz()

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@index([liveSessionId], map: "idx_live_invitations_session")
  @@index([invitedAccountId], map: "idx_live_invitations_invited_account")
  @@map("live_invitations")
}

// ============================================
// PHASE 6 — TOURISM (verified heritage SOURCE) & LEARNING (language lessons)
// Additive models for two PUBLIC verticals surfaced in discovery:
//   - TOURISM: highlighted places of heritage/tourism. Data may originate from
//     the Ministry of Tourism / NGOs / the community, but is used STRICTLY as a
//     cited SOURCE with provenance shown (source + source_ref). INDEPENDENCE is
//     a core value: this data NEVER governs or controls the family graph, has
//     NO write access to it, and is never coupled to private person data. A
//     TourismPlace is PUBLIC content carrying only place metadata + provenance.
//   - LEARNING: structured mini-lessons preserving culture, especially LANGUAGE
//     lessons. A LearningLesson is authored content (reusing the CulturalContent
//     idea); a lesson from a VERIFIED CulturalAuthority may be auto-approved
//     (moderation_status APPROVED), otherwise PENDING. It may be ticketed and
//     linked to a live LESSON (live_session_id). Users enroll and track progress
//     via LessonEnrollment.
//
// Cross-aggregate references (Account / CulturalAuthority / Media / LiveSession)
// are kept as plain scalar UUID columns here; the real FOREIGN KEY constraints
// are declared in the hand-written migration, keeping the change additive on the
// existing Account / CulturalAuthority / Media / LiveSession models (no
// back-relation fields required on them). The relation strictly between the two
// new learning models (LearningLesson <-> LessonEnrollment) is a full Prisma
// relation. All three models are soft-deletable where applicable, visibility-
// scoped (default PUBLIC), and mutations write a Contribution audit row
// (enforced in services).
// ============================================

enum TourismSource {
  MINISTRY
  NGO
  COMMUNITY

  @@map("tourism_source")
}

enum TourismCategory {
  HERITAGE
  NATURE
  CULTURE
  MUSEUM
  CHEFFERIE
  RELIGIOUS
  OTHER

  @@map("tourism_category")
}

enum LearningLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED

  @@map("learning_level")
}

// A highlighted place of heritage/tourism surfaced PUBLIC in discovery. The
// data is treated STRICTLY as a cited SOURCE: `source` records the kind of
// origin (MINISTRY / NGO / COMMUNITY) and `source_ref` carries the provenance
// citation/url shown to users. `verified` (set by a moderator/admin via
// verified_by_account_id) reflects source verification only — it confers NO
// authority over the family graph. This model carries NO family-graph data.
model TourismPlace {
  id                   String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                 String          @db.VarChar(200)
  description          String?
  region               String?         @db.VarChar(120)
  category             TourismCategory
  latitude             Decimal?        @db.Decimal(9, 6)
  longitude            Decimal?        @db.Decimal(9, 6)
  source               TourismSource
  sourceRef            String?         @map("source_ref") @db.VarChar(300)
  imageUrl             String?         @map("image_url") @db.VarChar(500)
  verified             Boolean         @default(false)
  verifiedByAccountId  String?         @map("verified_by_account_id") @db.Uuid
  mediaId              String?         @map("media_id") @db.Uuid
  submittedByAccountId String?         @map("submitted_by_account_id") @db.Uuid
  visibilityScope      VisibilityScope @default(PUBLIC) @map("visibility_scope")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt            DateTime?       @map("deleted_at") @db.Timestamptz()

  @@index([region], map: "idx_tourism_places_region")
  @@index([category], map: "idx_tourism_places_category")
  @@index([verified], map: "idx_tourism_places_verified")
  @@index([source], map: "idx_tourism_places_source")
  @@map("tourism_places")
}

// A structured mini-lesson preserving culture, especially LANGUAGE lessons
// (language_code = the language taught). Authored by an account and optionally
// attributed to a CulturalAuthority (authority_id); a lesson from a VERIFIED
// authority may be auto-approved (moderation_status APPROVED), otherwise it goes
// through moderation (PENDING). May be ticketed (is_ticketed) and linked to a
// live LESSON (live_session_id) or premium. visibility_scope defaults to PUBLIC;
// this content carries NO family-graph data. `position` orders lessons within a
// language/course track.
model LearningLesson {
  id               String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title            String           @db.VarChar(200)
  description      String?
  content          String?
  languageCode     String?          @map("language_code") @db.VarChar(10)
  level            LearningLevel    @default(BEGINNER)
  ethnicGroup      String?          @map("ethnic_group") @db.VarChar(120)
  authorityId      String?          @map("authority_id") @db.Uuid
  authorAccountId  String           @map("author_account_id") @db.Uuid
  mediaId          String?          @map("media_id") @db.Uuid
  isTicketed       Boolean          @default(false) @map("is_ticketed")
  liveSessionId    String?          @map("live_session_id") @db.Uuid
  visibilityScope  VisibilityScope  @default(PUBLIC) @map("visibility_scope")
  moderationStatus ModerationStatus @default(PENDING) @map("moderation_status")
  position         Int              @default(0)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz()

  enrollments LessonEnrollment[]

  @@index([languageCode], map: "idx_learning_lessons_language_code")
  @@index([level], map: "idx_learning_lessons_level")
  @@index([moderationStatus, createdAt(sort: Desc)], map: "idx_learning_lessons_moderation_created")
  @@map("learning_lessons")
}

// An account's enrollment in a LearningLesson, tracking progress_percent and
// completion (completed_at). Unique per (lesson, account).
model LessonEnrollment {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lessonId        String    @map("lesson_id") @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  progressPercent Int       @default(0) @map("progress_percent")
  completedAt     DateTime? @map("completed_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  lesson LearningLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, accountId], map: "uq_lesson_enrollment_lesson_account")
  @@index([lessonId], map: "idx_lesson_enrollments_lesson")
  @@index([accountId], map: "idx_lesson_enrollments_account")
  @@map("lesson_enrollments")
}

// ============================================
// ENGAGEMENT LAYER — polymorphic interactions over PUBLIC discovery entities
// (tourism places + cultural content). Reactions, comments, contributed photos
// (moderated), star ratings (tourism only) and edit-suggestions. `target_id` is
// a plain polymorphic UUID keyed by `target_type` (no FK on it). Cross-aggregate
// references to accounts / media / tourism_places are plain scalar UUIDs in the
// Prisma schema; the real FOREIGN KEYs are declared in the migration. This layer
// carries NO family-graph data and NEVER leaks phone numbers or private person
// data — only public author display names are surfaced (resolved in the service).
// ============================================

enum EngagementTargetType {
  TOURISM_PLACE
  CULTURAL_CONTENT

  @@map("engagement_target_type")
}

// One replaceable reaction per (target, account). reaction_type is a free String
// validated by DTO against a closed vocabulary (LIKE / LOVE / WOW / VISITED).
model EntityReaction {
  id           String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  targetType   EngagementTargetType @map("target_type")
  targetId     String               @map("target_id") @db.Uuid
  accountId    String               @map("account_id") @db.Uuid
  reactionType String               @map("reaction_type") @db.VarChar(30)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([targetType, targetId, accountId], map: "uq_entity_reaction")
  @@index([targetType, targetId], map: "idx_entity_reactions_target")
  @@map("entity_reactions")
}

// Soft-deletable comment on a public entity. Author or moderator may delete.
model EntityComment {
  id         String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  targetType EngagementTargetType @map("target_type")
  targetId   String               @map("target_id") @db.Uuid
  accountId  String               @map("account_id") @db.Uuid
  body       String
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt  DateTime?            @map("deleted_at") @db.Timestamptz()

  @@index([targetType, targetId, createdAt], map: "idx_entity_comments_target_created")
  @@map("entity_comments")
}

// A user-contributed photo awaiting moderation. APPROVED photos are shown to
// everyone; the contributor also sees their own PENDING uploads.
model EntityPhoto {
  id                  String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  targetType          EngagementTargetType @map("target_type")
  targetId            String               @map("target_id") @db.Uuid
  accountId           String               @map("account_id") @db.Uuid
  mediaId             String               @map("media_id") @db.Uuid
  caption             String?              @db.VarChar(300)
  status              String               @default("PENDING") @db.VarChar(20)
  reviewedByAccountId String?              @map("reviewed_by_account_id") @db.Uuid
  reviewedAt          DateTime?            @map("reviewed_at") @db.Timestamptz()
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz()

  @@index([targetType, targetId, status], map: "idx_entity_photos_target_status")
  @@map("entity_photos")
}

// A star rating (1..5) for a tourism place. One replaceable rating per account.
model PlaceRating {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  placeId   String   @map("place_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  stars     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([placeId, accountId], map: "uq_place_rating")
  @@index([placeId], map: "idx_place_ratings_place")
  @@map("place_ratings")
}

// A proposed correction to a field on a public entity. Recorded for moderator
// review; APPROVE/REJECT only records the decision (never auto-applies the edit).
model EditSuggestion {
  id                  String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  targetType          EngagementTargetType @map("target_type")
  targetId            String               @map("target_id") @db.Uuid
  accountId           String               @map("account_id") @db.Uuid
  field               String               @db.VarChar(60)
  proposedValue       String               @map("proposed_value")
  note                String?
  status              String               @default("PENDING") @db.VarChar(20)
  reviewedByAccountId String?              @map("reviewed_by_account_id") @db.Uuid
  reviewedAt          DateTime?            @map("reviewed_at") @db.Timestamptz()
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz()

  @@index([status], map: "idx_edit_suggestions_status")
  @@map("edit_suggestions")
}
