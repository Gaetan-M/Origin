# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genealogie_dev?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT / Auth
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=90d
OTP_EXPIRY_MINUTES=5
PIN_SALT_ROUNDS=10

# AWS
AWS_REGION=af-south-1
AWS_KMS_KEY_ID=

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=debug

# Observability (Sentry)
# Leave SENTRY_DSN empty to disable error tracking — initialization is a no-op
# when unset, so local/dev/test boot normally without Sentry.
SENTRY_DSN=
# Optional release tag (e.g. git SHA injected by the deploy pipeline).
SENTRY_RELEASE=

# LiveKit (leave empty to disable LIVE — token minting returns "not configured")
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
